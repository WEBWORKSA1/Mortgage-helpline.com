# All optional — the site runs without them. Set in Vercel > Project > Settings > Environment Variables.

# AI helpline (server-only)
ANTHROPIC_API_KEY=
HELPLINE_MODEL=claude-sonnet-5-5
HELPLINE_LIMIT=25

# Form delivery. Without these, forms use a zero-config relay that sends a one-time
# activation email to the site inbox on first use. RESEND is the most reliable.
RESEND_API_KEY=
MAIL_FROM=
WEB3FORMS_KEY=
# CONTACT_EMAIL overrides the built-in (server-only) inbox
CONTACT_EMAIL=

# Support/contribution checkout. DONATE_URL (e.g. a Stripe Payment Link) wins;
# PAYPAL_MERCHANT_ID keeps the inbox out of the PayPal redirect.
DONATE_URL=
PAYPAL_MERCHANT_ID=

# AdSense manual ad unit (Auto ads work without it)
NEXT_PUBLIC_ADSENSE_SLOT=
# Your YouTube channel (shows a Subscribe button on /videos)
NEXT_PUBLIC_YOUTUBE_CHANNEL_URL=

# Locks /api/refresh to Vercel Cron (Vercel sends it automatically when set)
CRON_SECRET=
